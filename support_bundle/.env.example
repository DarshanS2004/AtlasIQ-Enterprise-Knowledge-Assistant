APP_ENV=development
APP_NAME=AtlasIQ Enterprise Knowledge Assistant
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ENABLE_LANGCHAIN_RUNTIME=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
